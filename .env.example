# Configuração da credencial do Google Sheets
# IMPORTANTE: Coloque o caminho completo para o arquivo JSON local
# Exemplo Windows: SHEETS_CREDENTIALS_PATH=C:\Users\seu_usuario\path\to\pix-inteligente-499220-acd0a7fbcf30.json
# Exemplo Linux/Mac: SHEETS_CREDENTIALS_PATH=/home/seu_usuario/path/to/pix-inteligente-499220-acd0a7fbcf30.json
SHEETS_CREDENTIALS_PATH=

